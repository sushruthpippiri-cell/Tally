# Copy to .env for local runs outside Docker. Every variable the backend reads is listed here.
ENV=dev                                   # dev | test | prod
# App role (DML only). Migrations use the owner role below (DDL).
DATABASE_URL=postgresql+asyncpg://tally_app:tally_app_dev@localhost:5432/tally
DATABASE_MIGRATION_URL=postgresql+psycopg://tally_owner:tally_owner_dev@localhost:5432/tally
JWT_SECRET=dev-only-secret-change-me      # REQUIRED in prod (startup fails without it)
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173        # comma-separated; REQUIRED in prod
MIN_AGENT_VERSION=0.0.0
MIN_TDL_VERSION=0.0.0
# D-029: defaults to true in dev/test and false in prod when unset.
# ALLOW_UNVERIFIED_INCREMENTAL=true
# Optional: only used by the anomaly module (P15).
# ANTHROPIC_API_KEY=
# ANOMALY_EXPLAINER_MODEL=

# docker compose only (deploy/docker-compose.yml); dev defaults apply when unset
# POSTGRES_PASSWORD=postgres_dev
# TALLY_OWNER_PASSWORD=tally_owner_dev
# TALLY_APP_PASSWORD=tally_app_dev
