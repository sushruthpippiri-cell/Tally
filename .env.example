# Copy to .env for local runs outside Docker. Every variable the backend reads is listed here.
ENV=dev                                   # dev | test | prod
# App role (DML only). Migrations use the owner role below (DDL).
DATABASE_URL=postgresql+asyncpg://tally_app:tally_app_dev@localhost:5432/tally
DATABASE_MIGRATION_URL=postgresql+psycopg://tally_owner:tally_owner_dev@localhost:5432/tally
JWT_SECRET=dev-only-jwt-secret-change-me-in-prod      # REQUIRED in prod (startup fails without it)
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173        # comma-separated; REQUIRED in prod
MIN_AGENT_VERSION=0.0.0
MIN_TDL_VERSION=0.0.0
# D-029: defaults to true in dev/test and false in prod when unset.
# ALLOW_UNVERIFIED_INCREMENTAL=true
# PDF exports render off the event loop, at most this many at a time per process (D-053 #7a).
# WeasyPrint is CPU-heavy, so this protects the server; it is not a per-company setting.
PDF_MAX_CONCURRENT=2
# Optional: only used by the anomaly module (P15), and only while
# FEATURE_ANOMALY_DETECTION is on for a company. With either unset, anomalies are still found
# and shown with their evidence; the explanation reads "unavailable" (AC-58).
# The model must support the `effort` parameter - every current model except Claude Haiku 4.5.
# ANTHROPIC_API_KEY=
# ANOMALY_EXPLAINER_MODEL=claude-sonnet-5-5
# The anomaly MCP server's own connection: SELECT on anomaly_flags only, scoped to one company
# by row-level security (D-055 #5). Defaults to the dev role when unset.
# ANOMALY_READONLY_DATABASE_URL=postgresql://tally_readonly:tally_readonly_dev@localhost:5432/tally

# docker compose only (deploy/docker-compose.yml); dev defaults apply when unset
# POSTGRES_PASSWORD=postgres_dev
# TALLY_OWNER_PASSWORD=tally_owner_dev
# TALLY_APP_PASSWORD=tally_app_dev
# TALLY_READONLY_PASSWORD=tally_readonly_dev
