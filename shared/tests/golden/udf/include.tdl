[#Line: TA_LedgersLine]
    Add : Fields : TA_UDF_LEDGER_credit_days, TA_UDF_LEDGER_key_account, TA_UDF_LEDGER_kyc_date

[Field: TA_UDF_LEDGER_credit_days]
    Use    : Name Field
    Set As : $$String:$CreditLimitDays    ;; GATE-G22
    XMLTag : "UDF_CREDIT_DAYS"

[Field: TA_UDF_LEDGER_key_account]
    Use    : Name Field
    Set As : $$String:$IsKeyAccount    ;; GATE-G22
    XMLTag : "UDF_KEY_ACCOUNT"

[Field: TA_UDF_LEDGER_kyc_date]
    Use    : Name Field
    Set As : $$String:$KYCDate    ;; GATE-G22
    XMLTag : "UDF_KYC_DATE"

[#Line: TA_VchLine]
    Add : Fields : TA_UDF_VOUCHER_order_ref

[Field: TA_UDF_VOUCHER_order_ref]
    Use    : Name Field
    Set As : $$String:$OrderRef    ;; GATE-G22
    XMLTag : "UDF_ORDER_REF"
